<body data-bs-spy="scroll" data-bs-target="#header" tabindex="0">
	<div id="header-wrap">
		<div class="top-content d-flex justify-content-between align-items-center">
			<div class="LogoImage">
				<img src="~/images/image_readora-removebg-preview.png" />
			</div>
			<div class="marquee-container">
				<div class="marquee-track">
					<span>
						Where every blank page finds a voice and every curious soul finds a story — Welcome to Readora.
					</span>
					<span>
						Where every blank page finds a voice and every curious soul finds a story — Welcome to Readora.
					</span>
				</div>
			</div>
			<div class="d-flex align-items-center right-section">

				@if (Context.Session.GetString("UserName") != null)
				{
					<div class="dropdown">
						<a class="nav-link dropdown-toggle" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown">
							<i class="icon icon-user"></i> @Context.Session.GetString("UserName")
						</a>
						<ul class="dropdown-menu dropdown-menu-end">
							<li><a class="dropdown-item" href="/UserProfile">My Profile</a></li>
							<li><a class="dropdown-item" href="/Support">Help & Support</a></li>
							<li><hr class="dropdown-divider"></li>
							<li><a class="dropdown-item text-danger" href="/Logout">Logout</a></li>
						</ul>
					</div>
				}
				else
				{
					<a href="/login" class="login-link">Login</a>
					<a href="/register" class="register-btn">Register</a>
				}
				<div class="action-menu d-inline-block ms-3">
					<div class="search-bar">
						<a href="#" class="search-button search-toggle" data-selector="#header-wrap">
							<i class="icon icon-search"></i>
						</a>

						<form role="search" method="get" action="/Index" class="search-box">
							<input name="searchQuery" class="search-field text search-input" placeholder="Search for stories" type="search">
						</form>
					</div>
				</div>
				</div>
				</div>
				</div>
	
			<header id="header" class="py-2 shadow-sm bg-white">
		<div class="container-fluid">
			<nav class="navbar navbar-expand-md">
				<a href="/Index" class="navbar-brand logo-text">READORA</a>
				<button class="navbar-toggler" type="button"
						data-bs-toggle="collapse"
						data-bs-target="#mainNav">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse justify-content-end" id="mainNav">
					<ul class="navbar-nav">
						<li class="nav-item px-3"><a class="nav-link" asp-page="/Index">Home</a></li>
						<li class="nav-item px-3"><a class="nav-link" href="/about">About Us</a></li>
						<li class="nav-item px-3"><a class="nav-link" href="/browse">Browse</a></li>
						<li class="nav-item px-3"><a class="nav-link" href="/categories">Categories</a></li>
						@if (Context.Session.GetString("UserRole") == "Writer")
						{
							<li class="nav-item px-3"><a class="nav-link" href="/WriteContent">Write</a></li>
						}
					</ul>
				</div>
			</nav>
		</div>
	</header>

