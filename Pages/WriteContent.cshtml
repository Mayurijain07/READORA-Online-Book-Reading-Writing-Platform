@page
@model ReadoraProject.Pages.WriteModel
@{
    Layout = null;
    ViewData["Title"] = "Write Content";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<style>
    /* Professional Background: Light, Clear, No excessive blur */
    .write-page-wrapper {
        background: linear-gradient(rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.7)), 
                    url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=2000');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        padding: 50px 15px;
    }

    .write-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 50px;
        max-width: 950px;
        margin: auto;
    }

    /* Logo and Heading Styling */
    .brand-logo { width: 180px; margin-bottom: 5px; }
    .heading-text { color: #2b3a67; font-weight: 800; font-size: 2.2rem; }
    .sub-heading { color: #555; font-size: 1.1rem; margin-bottom: 30px; }

    .form-control, .form-select { border-radius: 10px; padding: 12px; border: 1px solid #ced4da; }
    .form-label { font-weight: 600; color: #333; }

    /* Buttons */
    .btn-draft { background: #6c757d; color: white; padding: 12px 30px; border-radius: 8px; }
    .btn-publish { background: #ff6122; color: white; padding: 12px 30px; border-radius: 8px; border: none; }

   
</style>

<div class="write-page-wrapper">
    <div class="container">
        <div class="write-card">
            <div class="mb-4">
                <a asp-page="/Dashboard" class="text-decoration-none" style="color:#6c757d;">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
            <div class="text-center">
                <img src="/images/READORA__1_-removebg-preview.png" alt="Readora Logo" class="brand-logo" />
                <h2 style="font-weight:700; letter-spacing:0.5px; color:#2b3a67; font-size:36px;">
                    Create and Share Your Story
                </h2>

                <p style="color:#6c757d; font-size:16px;">
                    Write your content and publish it for the Readora community.
                </p>
            </div>

            <form method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Content.ContentId" />

                <input type="hidden" name="status" id="statusField" value="0" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">Story Title</label>
                        <input asp-for="Content.Title" class="form-control" placeholder="Enter Title..." required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Content Type</label>
                        <select asp-for="Content.ContentType" class="form-select">
                            <option value="Story">Story</option>
                            <option value="Poem">Poem</option>
                            <option value="Article">Article</option>
                            <option value="Short Content">Short Content</option>
                            <option value="Blog">Blog</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select asp-for="Content.CategoryId" class="form-select">
                            <option value="">Select Category</option>
                            @foreach (var cat in Model.CategoryList) {
                                <option value="@cat.CategoryId">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cover Image</label>
                        <input type="file" name="file" class="form-control" />
                    </div>
                </div>

                <div class="mt-4">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Content.Description" class="form-control" rows="8" placeholder="Start your writing masterpiece here..."></textarea>
                </div>

                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-draft me-3" onclick="document.getElementById('statusField').value = '0';">
                        <i class="bi bi-journal-bookmark"></i> Save as Draft
                    </button>
                    <button type="submit" class="btn btn-publish" onclick="document.getElementById('statusField').value = '1';">
                        <i class="bi bi-send"></i> Publish Now
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    function setStatus(val) { document.getElementById("statusField").value = val; }
</script>


















