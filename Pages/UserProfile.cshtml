@page
@model ReadoraProject.Pages.UserProfileModel
@{
    Layout = null;
}
 
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .sidebar { min-height: 100vh; background: #2c3e50; color: white; padding: 20px; }
        .sidebar a { color: #ecf0f1; text-decoration: none; display: block; padding: 12px; border-radius: 5px; transition: 0.3s; }
        .sidebar a:hover { background: #1abc9c; }
        .profile-img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid #1abc9c; }
        .card { border: none; box-shadow: 0 0 15px rgba(0,0,0,0.1); margin-bottom: 20px; }
    </style>
</head>
<body>
<div class="d-flex">
    <div class="sidebar" style="width: 270px;">
        <h3 class="text-center">Readora</h3><hr>
        <nav class="nav flex-column">
            <a href="#profile"><i class="bi bi-person"></i> Profile</a>
            
            @if (Model.IsOwnProfile) {
              
                <a href="#history"><i class="bi bi-clock-history"></i> My Reading History</a>
                <a href="#fav"><i class="bi bi-star"></i> My Favourites</a>
                @if (Model.RoleType != "Reader") {
                    <a href="#drafts"><i class="bi bi-file-earmark-text"></i> My Drafts</a>
                }
                <a asp-page="/EditProfile"><i class="bi bi-pencil-square"></i> Edit Profile</a>
                <a asp-page="/Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
            }
            
            <a href="#published"><i class="bi bi-book"></i> Published Content</a>
            <a href="#followers"><i class="bi bi-people"></i> Followers / Following</a>
        </nav>
    </div>

    <div class="content flex-grow-1 p-5 bg-light">
            <div class="card p-4 shadow-sm" id="profile" style="position: relative;">
                @* Relative zaroori hai *@

                @if (!Model.IsOwnProfile)
                {
                    <a asp-page="/Index" class="text-secondary"
                       style="position: absolute; top: 15px; left: 15px; font-size: 1.5rem; transition: 0.3s;">
                        <i class="bi bi-arrow-left-circle-fill"></i> @* Fill wala icon zyada premium lagega *@
                    </a>
                }

                <div class="d-flex align-items-center mt-2">
                    @* mt-2 thoda space dega *@
                    <img src="@Model.PhotoUrl" class="profile-img me-4 shadow-sm">
                <div>
                    <h2 class="mb-0" style="color: #2c3e50; font-weight: 700;">@Model.Username</h2>
                    
                    @if (!string.IsNullOrEmpty(Model.ProfileFullName)) {
                        <h5 class="text-muted mt-1" style="font-weight: 500;">@Model.ProfileFullName</h5>
                    }

                    <p class="text-muted mb-2" style="font-size: 0.9rem;">
                        <i class="bi bi-calendar3"></i> <strong>Joined:</strong> @(Model.CreateDate ?? "N/A")
                    </p>
                        <div class="mb-2">
                            <span class="me-3"><strong>@Model.FollowerCount</strong> Followers</span>
                            <span><strong>@Model.FollowingCount</strong> Following</span>
                        </div>

                    <p class="mt-3" style="max-width: 500px;">@Model.Bio</p>

                    <div class="d-flex gap-2 mt-3">
                        @if (Model.IsOwnProfile) {
                            <form method="post" asp-page-handler="SwitchRole">
                                <button class="btn btn-success px-4">Switch to @(Model.RoleType == "Reader" ? "Writer" : "Reader")</button>
                            </form>
                            <a asp-page="/EditProfile" class="btn btn-outline-dark px-4">Edit Profile</a>
                        } 
                            else
                            {
                                @* Purane simple button ki jagah ye Form wala button *@
                                <form method="post" asp-page-handler="ToggleFollow">
                                    @* Target User ki ID hidden field mein bhejna zaroori hai *@
                                    <input type="hidden" name="targetId" value="@Model.AppUser?.UserId" />

                                    <button type="submit" class="btn @(Model.IsFollowing ? "btn-outline-primary" : "btn-primary") px-5 rounded-pill shadow-sm">
                                        @if (Model.IsFollowing)
                                        {
                                            <span><i class="bi bi-person-x"></i> Unfollow</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-person-plus"></i> Follow</span>
                                        }
                                    </button>
                                </form>
                           
                        }
                    </div>
                </div>
            </div>
        </div>

            <div class="row">
                @if (!Model.IsOwnProfile || Model.RoleType != "Reader")
                {
                    <div class="col-md-12">
                        <div class="card p-4" id="published">
                            <h4>Published Content</h4>
                            @if (Model.PublishedStories != null && Model.PublishedStories.Any())
                            {
                                @foreach (var story in Model.PublishedStories)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="card shadow-sm h-100">
                                            <img src="@story.CoverImage" class="card-img-top" style="height:120px; object-fit:cover;">
                                            <div class="card-body">
                                                <h6 class="card-title">@story.Title</h6>
                                                <a asp-page="/Details" asp-route-id="@story.ContentId" class="btn btn-sm btn-primary w-100">Read More</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Stories by @Model.Username... (Nothing yet)</p>
                            }
                        </div>
                    </div>
                }

            @if (Model.IsOwnProfile) {


                    @* --- READING HISTORY SECTION --- *@
                    <div class="col-md-6">
                        <div class="card p-4 shadow-sm" id="history">
                            <h4><i class="bi bi-clock-history text-primary"></i> Reading History</h4>
                            <div class="list-group list-group-flush">
                                @if (Model.ReadingHistory.Any())
                                {
                                    @foreach (var story in Model.ReadingHistory)
                                    {
                                        <a asp-page="/Details" asp-route-id="@story.ContentId" class="list-group-item list-group-item-action border-0 px-0">
                                            <i class="bi bi-book me-2"></i> @story.Title
                                        </a>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No stories read yet.</p>
                                }
                            </div>
                        </div>
                    </div>

                    @* --- FAVOURITE CONTENT SECTION --- *@
                    <div class="col-md-6">
                        <div class="card p-4 shadow-sm" id="fav">
                            <h4><i class="bi bi-star text-warning"></i> Favourite Content</h4>
                            <div class="list-group list-group-flush">
                                @if (Model.FavoriteStories.Any())
                                {
                                    @foreach (var fav in Model.FavoriteStories)
                                    {
                                        <a asp-page="/Details" asp-route-id="@fav.ContentId" class="list-group-item list-group-item-action border-0 px-0">
                                            <i class="bi bi-heart-fill text-danger me-2"></i> @fav.Title
                                        </a>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No favourites added.</p>
                                }
                            </div>
                        </div>
                    </div>

                    @* --- SAVED DRAFTS SECTION --- *@
                    @if (Model.IsOwnProfile && Model.RoleType != "Reader")
                    {
                        <div class="col-md-12">
                            <div class="card p-4 shadow-sm border-start border-danger border-4" id="drafts">
                                <h4><i class="bi bi-file-earmark-lock text-danger"></i> Saved Drafts (Private)</h4>
                                <div class="row mt-3">
                                    @if (Model.SavedDrafts.Any())
                                    {
                                        @foreach (var draft in Model.SavedDrafts)
                                        {
                                            <div class="col-md-4 mb-2">
                                                <div class="p-3 border rounded bg-white">
                                                    <h6>@draft.Title</h6>
                                                    <a asp-page="/WriteContent" asp-route-id="@draft.ContentId" class="btn btn-outline-danger btn-sm">
                                                        Continue Writing
                                                    </a>
                                                </div>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@draft.ContentId"
                                                      onsubmit="return confirm('Are you sure you want to Delete the Draft?');">
                                                    <button type="submit" class="btn btn-link text-danger p-0" title="Delete Draft">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted ms-2">No drafts found.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
            }
        </div>
    </div>
</div>
</body>
</html>




