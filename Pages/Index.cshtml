    <div class="row g-4">
        @if (Model.AllContents != null)
        {
            @foreach (var item in Model.AllContents.Where(c => c.ContentType == "Blog").Take(3))
            {
                <div class="col-lg-4 col-md-6">
                    <div class="rd-story-card shadow-sm">
                        <div class="img-container">
                            <img src="@item.CoverImage" class="card-img-custom" alt="Blog">
                            <span class="badge bg-success position-absolute top-0 start-0 m-3">@item.ContentType</span>
                        </div>
                        <div class="rd-card-body">
                            <a asp-page="/UserProfile" asp-route-id="@item.UserId" class="author-link">
                                <i class="bi bi-person-circle"></i>
                                <span>@item.User?.Username</span>
                            </a>
                            <a asp-page="/Details" asp-route-id="@item.ContentId" class="h5 fw-bold text-decoration-none text-dark d-block mb-2">@item.Title</a>
                            <p class="desc-text">@item.Description</p>
                            <div class="rd-footer">
                                <div class="icon-actions">
                                    @if (HttpContext.Session.GetInt32("UserId") != null)
                                    {
                                        <form method="post" asp-page-handler="ToggleLike" asp-route-contentId="@item.ContentId" style="display:flex;">
                                            <button type="submit" class="icon-link" title="Like">
                                                <i class="bi @(item.IsLikedByMe ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                                            </button>
                                        </form>

                                        <a asp-page="/Details" asp-route-id="@item.ContentId" class="icon-link" title="Comment" style="display:flex;">
                                            <i class="bi bi-chat-left"></i>
                                        </a>

                                        <form method="post" asp-page-handler="ToggleFav" asp-route-contentId="@item.ContentId" style="display:flex;">
                                            <button type="submit" class="icon-link" title="Favorite">
                                                <i class="bi @(item.IsFavByMe ? "bi-star-fill text-warning" : "bi-star")"></i>
                                            </button>
                                        </form>

                                        <button class="icon-link" title="Share"
                                                onclick="navigator.clipboard.writeText(window.location.origin + '/Details?id=@item.ContentId'); alert('Link Copied to Dashboard Context!');">
                                            <i class="bi bi-share"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="/Login" class="icon-link" title="Like"><i class="bi bi-heart"></i></a>
                                        <a href="/Login" class="icon-link" title="Comment"><i class="bi bi-chat-left"></i></a>
                                        <a href="/Login" class="icon-link" title="Favorite"><i class="bi bi-star"></i></a>
                                        <a href="/Login" class="icon-link" title="Share"><i class="bi bi-share"></i></a>
                                    }
                                </div>
                                <a asp-page="/Details" asp-route-id="@item.ContentId" class="btn-read-arrow">Read Blog →</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>















