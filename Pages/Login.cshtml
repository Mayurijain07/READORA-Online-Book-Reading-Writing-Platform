@page
@model ReadoraProject.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Readora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        body, html {
            height: 100%; margin: 0; font-family: 'Poppins', sans-serif; overflow: hidden;
        }

        .bg-image {
            background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), 
                              url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&q=80&w=2000');
            background-size: cover; background-position: center; height: 100vh;
            display: flex; align-items: center; justify-content: center;
        }

        .login-card {
            background-color: rgba(30, 30, 30, 0.95);
            color: white; padding: 45px; border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            width: 100%; max-width: 420px; text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .login-card h2 { font-weight: 600; margin-bottom: 8px; letter-spacing: 2px; }

        .subtitle { color: #aaa; font-size: 0.85rem; margin-bottom: 35px; }

        /* Binding friendly inputs */
        .input-group-text {
            background-color: #444; border: 1px solid #555; color: #aaa;
        }

        .form-control {
            background-color: #444; border: 1px solid #555; color: white !important;
            padding: 12px; border-radius: 8px;
        }

        .form-control:focus {
            background-color: #4a4a4a; border-color: #7ef9d1; box-shadow: 0 0 8px rgba(126, 249, 209, 0.3);
        }

        .btn-login {
            background-color: #7ef9d1; border: none; color: #1a1a1a;
            font-weight: 600; padding: 12px; width: 100%; border-radius: 8px;
            margin-top: 15px; text-transform: uppercase; transition: 0.3s;
        }

        .btn-login:hover { background-color: #5ee6bc; transform: translateY(-2px); }

        .forgot-link { display: block; margin-top: 15px; color: #888; text-decoration: none; font-size: 0.8rem; }
        .forgot-link:hover { color: #7ef9d1; }

        .social-icons { margin-top: 30px; }
        .social-icons i {
            margin: 0 12px; cursor: pointer; color: white; transition: 0.3s;
            padding: 10px; border: 1px solid rgba(255,255,255,0.1); border-radius: 50%;
        }
        .social-icons i:hover { color: #7ef9d1; border-color: #7ef9d1; background: rgba(126, 249, 209, 0.1); }

        .signup-link { margin-top: 35px; font-size: 0.85rem; color: #eee; }
        .signup-link a { color: #7ef9d1; text-decoration: none; font-weight: 600; }
        .signup-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="bg-image">
    <div class="login-card">
        <h2>LOGIN</h2>
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-warning text-center" style="font-size: 0.8rem; padding: 5px;">
                    @TempData["Message"]
                </div>
            }
        <p class="subtitle">Enter your credentials to access Readora</p>

        <form method="post">
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="input-group mb-3">
                <span class="input-group-text"><i class="fas fa-user"></i></span>
                <input asp-for="LoginRequest.Username" class="form-control" placeholder="Username" required />
            </div>

            <div class="input-group mb-3">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input asp-for="LoginRequest.Password" type="password" class="form-control" placeholder="Password" required />
            </div>

            <button type="submit" class="btn btn-login">Login</button>

            <div class="signup-link">
                Don't have an account? <a href="/Register">Sign Up Now</a>
            </div>
        </form>
    </div>
</div>

</body>
</html>