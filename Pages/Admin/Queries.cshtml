@page
@model ReadoraProject.Pages.Admin.QueriesModel
@{
    Layout = "_adminLayout";
    ViewData["Title"] = "User Queries";
}

<style>
    .admin-container {
        padding: 30px;
    }

    .card-custom {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .table-header {
        background-color: #2b3a67;
        color: white;
        padding: 20px;
    }

    .btn-read {
        background: #28a745;
        color: white;
        border: none;
        padding: 5px 12px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 5px 12px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-resolved {
        background: #d4edda;
        color: #155724;
        font-weight: bold;
        padding: 4px 10px;
        border-radius: 4px;
    }

    .badge-pending {
        background: #fff3cd;
        color: #856404;
        font-weight: bold;
        padding: 4px 10px;
        border-radius: 4px;
    }
</style>

<div class="admin-container">
    <div class="card-custom">
        <div class="table-header"><h4><i class="bi bi-question-circle-fill me-2"></i>User Queries Management</h4></div>
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Reg No</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.QueryDetails != null && Model.QueryDetails.Any())
                {
                    @foreach (var item in Model.QueryDetails)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.RegNo</td>
                            <td>@item.QueryTitle</td>
                            <td style="max-width: 250px;">@item.QueryDescription</td>
                            <td>
                                @(item.QueryStatus == true ? Html.Raw("<span class='badge-resolved'>Resolved</span>") : Html.Raw("<span class='badge-pending'>Pending</span>"))
                            </td>
                            <td>@item.QueryDate?.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                @if (item.QueryStatus != true)
                                {
                                    <button type="button" class="btn-read me-2" data-bs-toggle="modal" data-bs-target="#resolveModal-@item.QueryId">Resolve</button>
                                }
                                <form method="post" style="display:inline;">
                                    <button type="submit" asp-page-handler="Delete" asp-route-id="@item.QueryId" class="btn-delete" onclick="return confirm('Delete query?')">Delete</button>
                                </form>
                            </td>
                        </tr>

                        <div class="modal fade" id="resolveModal-@item.QueryId" tabindex="-1">
                            <div class="modal-dialog">
                                <form method="post" asp-page-handler="Resolve">
                                    <input type="hidden" name="id" value="@item.QueryId" />
                                    <div class="modal-content">
                                        <div class="modal-header"><h5>Resolve Query #@item.QueryId</h5></div>
                                        <div class="modal-body">
                                            <textarea name="message" class="form-control" placeholder="Enter resolution message..." required></textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-success">Save & Resolve</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                }
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            </tbody>
        </table>
    </div>
</div>