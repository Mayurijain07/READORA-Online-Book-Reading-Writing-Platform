@page
@model ReadoraProject.Pages.Admin.ContentModel
@{
    Layout = "_adminLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm mx-4" style="border-radius: 15px;">
        <div class="card-header bg-white border-0 py-4 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="fw-bold mb-0">Manage Stories</h3>
                <span class="badge px-3 py-2" style="background-color: #e3f2fd; color: #0d47a1; border-radius: 50px;">
                    Total Stories: @Model.Contents.Count
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background-color: #f8f9fa;">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-4 py-3">ID</th>
                            <th class="py-3">Title</th>
                            <th class="py-3">Author / Category</th>
                            <th class="py-3 text-center">Status</th>
                            <th class="text-end pe-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Contents) {
                        <tr style="vertical-align: middle;">
                            <td class="ps-4">#@item.ContentId</td>
                            <td class="fw-bold">@item.Title</td>
                            <td>
                                <div class="small text-dark">@@@item.AuthorName</div>
                                <div class="text-muted small">@item.CategoryName</div>
                            </td>
                            <td class="text-center">
                                @if(item.Status) { 
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 border-0">Approved</span>
                                } else {
                                    <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 border-0">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    @if(!item.Status) {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@item.ContentId">
                                            <button class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.ContentId" onsubmit="return confirm('Permanent delete?');">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
