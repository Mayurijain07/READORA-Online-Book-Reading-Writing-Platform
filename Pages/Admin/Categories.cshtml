@page
@model ReadoraProject.Pages.Admin.CategoriesModel
@{
    Layout = "_adminLayout";
}


<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm mx-4" style="border-radius: 15px;">
        <div class="card-header bg-white border-0 py-4 px-4" style="border-radius: 15px 15px 0 0;">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0" style="color: #2c3e50; font-weight: 700;">Category Management</h3>
                <button class="btn btn-primary px-4 py-2 shadow-sm" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    Add Category
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background-color: #f8f9fa;">
                        <tr class="text-secondary small text-uppercase fw-bold">
                            <th class="ps-4 py-3">Cat ID</th>
                            <th class="py-3">Category Name</th>
                            <th class="text-end pe-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr style="vertical-align: middle; border-bottom: 1px solid #f1f1f1;">
                                <td class="ps-4 py-3 fw-bold text-primary">#@cat.CategoryId</td>
                                <td class="py-3">
                                    <span class="badge px-3 py-2" style="background-color: #e3f2fd; color: #0d47a1; border-radius: 6px;">
                                        @cat.CategoryName
                                    </span>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@cat.CategoryId" 
                                          onsubmit="return confirm('Are you sure you want to delete this category?');">
                                        <button class="btn btn-danger btn-sm px-3 shadow-sm" style="border-radius: 6px;">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 py-3 px-4 text-muted small" style="border-radius: 0 0 15px 15px;">
            Total Categories: @Model.Categories.Count
        </div>
    </div>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold">Add New Genre</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body py-4">
                    <div class="form-group">
                        <label class="form-label text-muted small fw-bold">NAME</label>
                        <input asp-for="NewCategory.CategoryName" class="form-control form-control-lg border-1 bg-light shadow-none" 
                               placeholder="e.g. Science Fiction" required style="border-radius: 8px; font-size: 1rem;" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4">
                    <button type="button" class="btn btn-light px-4 me-2" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" style="border-radius: 8px;">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}</div>