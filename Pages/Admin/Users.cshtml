@page
@model ReadoraProject.Pages.Admin.UsersModel
@{
    Layout = "_adminLayout";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm mx-4" style="border-radius: 15px;">
        <<div class="card-header bg-white border-0 py-4 px-4" style="border-radius: 15px 15px 0 0;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0" style="color: #2c3e50; font-weight: 700;">Platform Users</h3>
                    <p class="text-muted small mb-0">Managing registered members and administrators</p>
                </div>
                <span class="badge px-3 py-2 fw-bold" style="background-color: #e3f2fd; color: #0d47a1; border-radius: 50px; font-size: 0.85rem;">
                    Total Users: @Model.Users.Count
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead style="background-color: #f8f9fa;">
                        <tr class="text-secondary small text-uppercase fw-bold">
                            <th class="ps-4 py-3">Reg No</th>
                            <th class="py-3">Username</th> <th class="py-3">Email & Contact</th>
                            <th class="py-3 text-center">Gender</th>
                            <th class="py-3 text-center">Role / Badge</th>
                            <th class="text-end pe-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr style="vertical-align: middle; border-bottom: 1px solid #f1f1f1;">
                                <td class="ps-4 py-3 text-primary fw-bold">@user.RegistrationNumber</td>
                                
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@@@user.Username</div>
                                </td>

                                <td class="py-3">
                                    <div class="small text-dark">@user.EmailId</div>
                                    <div class="small text-muted">@user.Contact</div>
                                </td>

                                <td class="py-3 text-center">
                                    <span class="badge @(user.Gender == "Male" ? "bg-info" : "bg-danger") bg-opacity-10 text-dark border-0">
                                        @user.Gender
                                    </span>
                                </td>

                                <td class="py-3 text-center">
                                    @if (user.RoleType == "Admin" || user.Username == "Mayuri")
                                    {
                                        <span class="badge bg-dark px-3 py-2" style="letter-spacing: 0.5px;">
                                            <i class="bi bi-shield-fill text-warning me-1"></i> ADMIN
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border px-3 py-2">MEMBER</span>
                                    }
                                </td>

                                <td class="text-end pe-4 py-3">
                                    @if (user.Username != "Mayuri")
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@user.UserId" 
                                              onsubmit="return confirm('Are you sure you want to remove this user?');">
                                            <button class="btn btn-sm btn-outline-danger px-3">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">System Protected</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
