@page
@model ReadoraProject.Pages.BrowseModel
@{

    ViewData["Title"] = "Browse Stories";
    Layout = "_Layout";
}

<style>
    /* 1. Full White Background and Clean Layout */
    body {
        background-color: #ffffff;
    }

    .browse-wrapper {
        padding: 60px 0 100px 0;
    }

    .browse-header {
        margin-bottom: 60px;
        position: relative;
    }

    .browse-header h1 {
        font-weight: 900;
        font-size: 3.5rem;
        color: #1a1a1a;
        letter-spacing: -1.5px;
        margin-bottom: 10px;
    }

    .browse-header .accent-line {
        width: 60px;
        height: 5px;
        background: #ff6122; /* Readora Orange */
        margin: 0 auto 20px auto;
        border-radius: 10px;
    }

    /* 2. Modern Story Card Design */
    .story-card {
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid #f0f0f0;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .story-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        border-color: #ff6122;
    }

    .story-img-container {
        position: relative;
        overflow: hidden;
    }

    .story-card img {
        transition: transform 0.5s ease;
    }

    .story-card:hover img {
        transform: scale(1.1);
    }

    /* 3. Button and Typography */
    .story-title {
        font-weight: 800;
        color: #1a1a1a;
        margin: 15px 0 5px 0;
        font-size: 1.25rem;
    }

    .btn-read {
        background: #1a1a1a;
        color: white !important;
        border: none;
        padding: 10px 25px;
        border-radius: 0; /* Matching your rectangle style */
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
        margin-top: auto;
    }

    .btn-read:hover {
        background: #ff6122;
        transform: scale(1.05);
    }

    .no-image-placeholder {
        height: 220px;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccc;
        font-weight: 600;
        border-radius: 12px;
    }
</style>

<div class="container browse-wrapper">
    <div class="browse-header text-center">
        <h1>Explore Stories<span style="color: #ff6122;">.</span></h1>
        <div class="accent-line"></div>
        <p style="font-size: 1.2rem; color: #666; font-weight: 500;">
            Discover masterpieces from the world's most creative minds.
        </p>
    </div>

    @if (Model.Contents != null && Model.Contents.Any())
    {
        <div class="row g-4">
            @foreach (var story in Model.Contents)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="story-card p-3 shadow-sm">
                        <div class="story-img-container shadow-sm mb-3" style="border-radius: 12px;">
                            @if (!string.IsNullOrEmpty(story.CoverImage))
                            {
                                <img src="@story.CoverImage" alt="@story.Title" class="img-fluid" style="width: 100%; height: 220px; object-fit: cover; border-radius: 12px;">
                            }
                            else
                            {
                                <div class="no-image-placeholder">
                                    <span>NO COVER</span>
                                </div>
                            }
                        </div>
                        
                        <h5 class="story-title">@story.Title</h5>
                        <p class="small" style="color: #ff6122; font-weight: 600;">
                            📅 @story.ContentDate.ToString("MMM dd, yyyy")
                        </p>
                        
                        <div class="mt-3">
                            <a href="/Details?id=@story.ContentId" class="btn-read w-100 text-center">
                                READ STORY
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
             <div class="text-center mt-5 pt-5">
            <hr style="border-top: 1px solid #eee; width: 50%; margin: 0 auto 40px auto;">
            <p class="text-muted mb-4">Done reading? Check out other genres!</p>
            <a href="/Categories" class="btn" style="border: 2px solid #1a1a1a; color: #1a1a1a; font-weight: 800; padding: 15px 40px; border-radius: 0; transition: 0.3s; letter-spacing: 1px;">
                ← BACK TO CATEGORIES
            </a>
        </div>
           }
    else
    {
        <div class="text-center py-5 shadow-lg"
             style="position: relative;
                    overflow: hidden;
                    border-radius: 40px;
                    min-height: 450px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: #1a1a1a; /* Fallback color agar image load na ho */
                    border: none;">

            <div style="position: absolute;
                        top: 0; left: 0; right: 0; bottom: 0;
                        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                                    url('https://images.pexels.com/photos/2908984/pexels-photo-2908984.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1') no-repeat center center/cover;
                        filter: blur(10px);
                        transform: scale(1.1);
                        z-index: 1;">
            </div>

            <div style="position: relative; z-index: 2; padding: 40px; width: 100%;">
                <div style="font-size: 5rem; margin-bottom: 20px; filter: drop-shadow(0 5px 15px rgba(0,0,0,0.3));">📚</div>

                <h3 style="font-weight: 900; color: #ffffff; font-size: 2.8rem; letter-spacing: -1px; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                    No stories found here yet<span style="color: #ff6122;">.</span>
                </h3>

                <p style="color: #eeeeee; margin-bottom: 40px; font-size: 1.3rem; font-weight: 400; max-width: 600px; margin-left: auto; margin-right: auto;">
                    This category is waiting for its first masterpiece. Be the one to start the legend.
                </p>

                <a href="/Categories" class="btn-read"
                   style="padding: 18px 60px;
                          background: #ff6122;
                          color: white !important;
                          text-decoration: none;
                          font-weight: 800;
                          text-transform: uppercase;
                          letter-spacing: 2px;
                          border-radius: 0;
                          display: inline-block;
                          transition: 0.3s;
                          box-shadow: 0 15px 30px rgba(255, 97, 34, 0.3);">
                    EXPLORE  ALL CATEGORIES
                </a>
            </div>
        </div>
    }
</div>





